{
  "name": "@zeta/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc && rm -rf dist/generated/client && mkdir -p dist/generated/client && cp -r src/generated/client/. dist/generated/client/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/seed-run.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "csv-parse": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
